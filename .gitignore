# AI-CONTEXT:
# Purpose: Git ignore rules for Next.js Enterprise Project.
# Scope: Excludes dependencies, build artifacts, local env files, and system logs.

# Dependencies
/node_modules
/.pnp
.pnp.js

# Testing
/coverage

# Next.js
/.next/
/out/

# Production
/build

# Misc
.DS_Store
*.pem

# Debug
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Local Env Files (Security Risk if committed)
.env*.local
.env
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts