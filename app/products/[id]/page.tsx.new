/**
 * AI-CONTEXT: Enterprise B2B Product Detail - Upgraded 2026-04
 * SSG with 12 products, B2B bulk pricing, traceability, RFQ integration
 * Preserves: generateStaticParams, dynamicParams=false
 * Added: breadcrumb, bulk tiers, packaging, COA, related products, JSON-LD, RFQ store
 */
import React from "react";
import Link from "next/link";
import { notFound } from "next/navigation";
import { CheckCircle2, Package, ArrowLeft, Download, ShieldCheck, Clock, Boxes, FileText, ChevronRight, Globe, Award, Truck } from "lucide-react";
import { Badge } from "@/components/ui/badge";
import { Separator } from "@/components/ui/separator";
import { Table, TableBody, TableCell, TableRow, TableHead, TableHeader } from "@/components/ui/table";
import { products, getProductById, getRelatedProducts } from "@/lib/data/products";
import { generatesB2BProductMetadata, B2BProductJsonLd, Breadcrumb } from "./product-client";
import type { Metadata } from "next";

// SSG
export const dynamicParams = false;
export async function generateStaticParams() {
  return products.map((p) => ({ id: p.id }));
}

export async function generateMetadata({ params }: { params: { id: string } }): Promise<Metadata> {
  const product = getProductById(params.id);
  if (!product) return {};
  return {
    title: `${product.name} | Bulk ${product.category} | Treishvaam Agro`,
    description: `${product.shortDesc} MOQ ${product.moq}, ${product.leadTime} lead time. ${product.certifications.join(", ")} certified. Request enterprise quote.`,
    openGraph: {
      title: product.name,
      description: product.shortDesc,
      images: [{ url: product.image }],
      type: "website",
    },
  };
}

export default function ProductDetail({ params }: { params: { id: string } }) {
  const product = getProductById(params.id);
  if (!product) notFound();
  const related = getRelatedProducts(product.id, 4);

  return (
    <div className="min-h-screen bg-brand-surface-off">
      {/* Breadcrumb */}
      <div className="bg-white border-b border-brand-border">
        <div className="max-w-7xl mx-auto px-6 xl:px-0 py-3 flex items-center gap-2 text-sm text-gray-500">
          <Link href="/" className="hover:text-brand-primary">Home</Link>
          <ChevronRight size={14} />
          <Link href="/products" className="hover:text-brand-primary">Products</Link>
          <ChevronRight size={14} />
          <Link href={`/products?category=${encodeURIComponent(product.category)}`} className="hover:text-brand-primary">{product.category}</Link>
          <ChevronRight size={14} />
          <span className="text-brand-dark font-medium truncate">{product.name}</span>
        </div>
      </div>

      <div className="max-w-7xl mx-auto px-6 xl:px-0 py-8">
        {/* Header Actions */}
        <div className="flex items-center justify-between mb-6">
          <Link href="/products" className="inline-flex items-center gap-2 text-sm font-semibold text-brand-textMuted hover:text-brand-primary">
            <ArrowLeft size={16} /> Back to Catalog
          </Link>
          <div className="flex items-center gap-2">
            <Badge variant="secondary" className="bg-brand-secondary text-brand-dark">{product.category}</Badge>
            {product.coaAvailable && <Badge className="bg-brand-dark text-white gap-1"><ShieldCheck size={12} /> COA Available</Badge>}
          </div>
        </div>

        <div className="grid grid-cols-1 lg:grid-cols-5 gap-8">
          {/* Left: Image + Gallery */}
          <div className="lg:col-span-2 space-y-4">
            <div className="bg-white rounded-card overflow-hidden border border-brand-border shadow-resting">
              <div className="aspect-square overflow-hidden bg-gray-50">
                <img src={product.image} alt={product.name} className="w-full h-full object-cover" />
              </div>
              <div className="p-4 grid grid-cols-3 gap-2 text-center text-xs">
                <div className="bg-brand-surface-off rounded p-3 border">
                  <div className="font-bold text-brand-dark">{product.moq}</div>
                  <div className="text-gray-500">MOQ</div>
                </div>
                <div className="bg-brand-surface-off rounded p-3 border">
                  <div className="font-bold text-brand-dark">{product.leadTime}</div>
                  <div className="text-gray-500">Lead Time</div>
                </div>
                <div className="bg-brand-surface-off rounded p-3 border">
                  <div className="font-bold text-brand-dark">{product.shelfLife}</div>
                  <div className="text-gray-500">Shelf Life</div>
                </div>
              </div>
            </div>

            <div className="bg-white rounded-card p-5 border border-brand-border shadow-sm">
              <h4 className="font-semibold text-brand-dark mb-3 flex items-center gap-2"><Globe size={16} className="text-brand-primary" /> Origin & Compliance</h4>
              <div className="space-y-2 text-sm">
                <div className="flex justify-between"><span className="text-gray-500">Origin</span><span className="font-medium text-brand-dark">{product.origin}</span></div>
                <div className="flex justify-between"><span className="text-gray-500">HS Code</span><span className="font-mono font-medium">{product.hsCode}</span></div>
                <div className="flex justify-between"><span className="text-gray-500">Storage</span><span className="font-medium text-brand-dark text-right max-w-[60%]">{product.storage}</span></div>
              </div>
              <div className="flex flex-wrap gap-1.5 mt-4">
                {product.certifications.map((c) => (
                  <span key={c} className="bg-brand-secondary text-brand-dark text-xs font-bold px-2.5 py-1 rounded-full border">{c}</span>
                ))}
              </div>
            </div>
          </div>

          {/* Right: Details */}
          <div className="lg:col-span-3 space-y-6">
            <div className="bg-white rounded-card p-6 md:p-8 border border-brand-border shadow-sm">
              <h1 className="text-3xl md:text-4xl font-bold text-brand-dark mb-3 tracking-tight">{product.name}</h1>
              <p className="text-brand-textMuted leading-relaxed mb-6">{product.description}</p>

              <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div className="bg-brand-surface-off rounded-xl p-5 border">
                  <h3 className="font-semibold text-brand-dark mb-3 flex items-center gap-2"><CheckCircle2 size={18} className="text-brand-primary" /> Key Features</h3>
                  <ul className="space-y-2.5">
                    {product.features.map((f, i) => (
                      <li key={i} className="flex items-start gap-2 text-sm text-gray-700">
                        <span className="w-1.5 h-1.5 rounded-full bg-brand-primary mt-2 flex-shrink-0" />
                        {f}
                      </li>
                    ))}
                  </ul>
                </div>

                <div className="bg-white rounded-xl border overflow-hidden">
                  <div className="bg-brand-surface-off px-5 py-3 border-b flex items-center gap-2">
                    <Package size={18} className="text-brand-primary" />
                    <h3 className="font-semibold text-brand-dark">Technical Specifications</h3>
                  </div>
                  <Table>
                    <TableBody>
                      {Object.entries(product.specifications).map(([k, v]) => (
                        <TableRow key={k}>
                          <TableCell className="font-medium text-gray-700 py-2.5 text-sm">{k}</TableCell>
                          <TableCell className="text-gray-600 py-2.5 text-sm">{v}</TableCell>
                        </TableRow>
                      ))}
                    </TableBody>
                  </Table>
                </div>
              </div>

              <Separator className="my-6" />

              {/* Bulk Pricing Tiers */}
              <div>
                <h3 className="font-semibold text-brand-dark mb-3 flex items-center gap-2"><Boxes size={18} className="text-brand-primary" /> Enterprise Bulk Pricing (FOB India)</h3>
                <div className="border rounded-xl overflow-hidden">
                  <Table>
                    <TableHeader>
                      <TableRow className="bg-brand-dark hover:bg-brand-dark">
                        <TableHead className="text-white font-semibold">MOQ</TableHead>
                        <TableHead className="text-white font-semibold">Price / kg</TableHead>
                        <TableHead className="text-white font-semibold">Notes</TableHead>
                      </TableRow>
                    </TableHeader>
                    <TableBody>
                      {product.bulkPricing.map((tier, idx) => (
                        <TableRow key={idx} className={idx === product.bulkPricing.length - 1 ? "bg-brand-secondary/30" : ""}>
                          <TableCell className="font-bold text-brand-dark">{tier.moq}</TableCell>
                          <TableCell className="font-semibold text-brand-primary">{tier.pricePerKg}</TableCell>
                          <TableCell className="text-gray-500 text-sm">{tier.note || (idx === product.bulkPricing.length - 1 ? "Best value" : "—")}</TableCell>
                        </TableRow>
                      ))}
                    </TableBody>
                  </Table>
                </div>
                <p className="text-xs text-gray-400 mt-2">Indicative pricing; final quote includes freight, packaging, and certifications. Valid 7 days.</p>
              </div>

              {/* Packaging & Applications */}
              <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <h4 className="font-semibold text-brand-dark mb-2 flex items-center gap-2"><Truck size={16} className="text-brand-primary" /> Packaging Options</h4>
                  <ul className="space-y-1.5">
                    {product.packagingOptions.map((p) => (
                      <li key={p} className="text-sm text-gray-600 flex items-center gap-2"><span className="w-1 h-1 bg-gray-400 rounded-full" />{p}</li>
                    ))}
                  </ul>
                </div>
                <div>
                  <h4 className="font-semibold text-brand-dark mb-2 flex items-center gap-2"><Award size={16} className="text-brand-primary" /> Key Applications</h4>
                  <div className="flex flex-wrap gap-1.5">
                    {product.applications.map((a) => (
                      <span key={a} className="bg-brand-secondary border text-brand-dark text-xs font-medium px-2.5 py-1 rounded-full">{a}</span>
                    ))}
                  </div>
                </div>
              </div>

              {/* Client-side RFQ Actions */}
              <Breadcrumb product={product} />
              <B2BProductJsonLd product={product} />
            </div>
          </div>
        </div>

        {/* Related */}
        {related.length > 0 && (
          <div className="mt-12">
            <h3 className="text-xl font-bold text-brand-dark mb-6">Related in {product.category}</h3>
            <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
              {related.map((r) => (
                <Link key={r.id} href={`/products/${r.id}`} className="bg-white rounded-card border border-brand-border overflow-hidden hover:shadow-lifted transition-all group">
                  <div className="aspect-[4/3] overflow-hidden">
                    <img src={r.image} alt={r.name} className="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                  </div>
                  <div className="p-4">
                    <p className="text-xs font-bold text-brand-primary uppercase tracking-wider">{r.category}</p>
                    <h4 className="font-semibold text-brand-dark line-clamp-1">{r.name}</h4>
                    <p className="text-xs text-gray-500 mt-1">MOQ {r.moq}</p>
                  </div>
                </Link>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  );
}
